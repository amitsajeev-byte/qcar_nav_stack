<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qcar_gazebo</name>
  <version>1.0.0</version>
  <description>ROS 2 / Gazebo Classic simulation, SLAM, and Nav2 (MPPI + SmacPlannerHybrid) navigation stack for the QCar Ackermann-steered robot - drives both the Gazebo simulation and the real QCar (see the sibling qcar_hardware package for the onboard bridge).</description>
  <maintainer email="amitsajeev@gmail.com">Amit Sajeev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>

  <!-- build + link deps for the custom EarlyCommitCritic MPPI plugin (src/critics/) -->
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>xtensor</depend>
  <depend>xsimd</depend>

  <!-- build + link deps for the custom CuspStraightenerSmoother plugin (src/smoothers/) -->
  <depend>nav2_core</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_mppi_controller plugin="${prefix}/qcar_critics.xml" />
    <nav2_core plugin="${prefix}/qcar_smoothers.xml" />
  </export>
</package>
